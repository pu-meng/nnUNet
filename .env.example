# DeepSeek helper is opt-in. Keep this value at 0 unless you explicitly want a request.
USE_DEEPSEEK_ASSISTANT=0

# Never commit a real API key. Copy this file to .env or export the key in the shell.
DEEPSEEK_API_KEY=

# Current official default alias at the time this file was created. Override when needed.
DEEPSEEK_MODEL=deepseek-flash

# The helper rejects oversized material instead of silently truncating it.
DEEPSEEK_MAX_INPUT_CHARS=30000
DEEPSEEK_TIMEOUT_SECONDS=60
