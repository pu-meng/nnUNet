#!/usr/bin/env bash
set -uo pipefail

LOG_FILE="${SSH_MONITOR_LOG_FILE:-/home/PuMengYu/SSH断开监控/监控.log}"
INTERVAL_SECONDS="${SSH_MONITOR_INTERVAL_SECONDS:-30}"
PUBLIC_TEST_IP="${SSH_MONITOR_PUBLIC_TEST_IP:-223.5.5.5}"

previous_state=""
previous_thermal_level=""

log_line() {
    printf '%s %s\n' "$(date --iso-8601=seconds)" "$*" >>"${LOG_FILE}"
}

read_cpu_temperature() {
    local hwmon_dir hwmon_name temperature

    for hwmon_dir in /sys/class/hwmon/hwmon*; do
        [[ -r "${hwmon_dir}/name" ]] || continue
        read -r hwmon_name <"${hwmon_dir}/name"
        [[ "${hwmon_name}" == "k10temp" ]] || continue
        [[ -r "${hwmon_dir}/temp1_input" ]] || continue
        read -r temperature <"${hwmon_dir}/temp1_input"
        printf '%d.%d' "$((temperature / 1000))" "$(((temperature % 1000) / 100))"
        return 0
    done

    printf 'N/A'
}

read_gpu_temperatures() {
    local temperatures

    temperatures="$(
        nvidia-smi \
            --query-gpu=index,temperature.gpu \
            --format=csv,noheader,nounits 2>/dev/null |
            tr -d ' ' |
            paste -sd ',' -
    )"
    printf '%s' "${temperatures:-N/A}"
}

read_igpu_temperature() {
    local hwmon_dir hwmon_name temperature

    for hwmon_dir in /sys/class/hwmon/hwmon*; do
        [[ -r "${hwmon_dir}/name" ]] || continue
        read -r hwmon_name <"${hwmon_dir}/name"
        [[ "${hwmon_name}" == "amdgpu" ]] || continue
        [[ -r "${hwmon_dir}/temp1_input" ]] || continue
        read -r temperature <"${hwmon_dir}/temp1_input"
        printf '%d.%d' "$((temperature / 1000))" "$(((temperature % 1000) / 100))"
        return 0
    done

    printf 'N/A'
}

read_cpu_frequency_mhz() {
    local frequency_file frequency total=0 count=0

    for frequency_file in /sys/devices/system/cpu/cpufreq/policy*/scaling_cur_freq; do
        [[ -r "${frequency_file}" ]] || continue
        read -r frequency <"${frequency_file}"
        total=$((total + frequency))
        count=$((count + 1))
    done

    if ((count > 0)); then
        printf '%d' "$((total / count / 1000))"
    else
        printf 'N/A'
    fi
}

read_counter() {
    local counter_file="$1"

    if [[ -r "${counter_file}" ]]; then
        cat "${counter_file}"
    else
        printf 'N/A'
    fi
}

temperature_level() {
    local temperature="$1" integer_temperature

    if [[ "${temperature}" == "N/A" ]]; then
        printf 'UNKNOWN'
        return
    fi

    integer_temperature="${temperature%%.*}"
    if ((integer_temperature >= 100)); then
        printf 'EMERGENCY'
    elif ((integer_temperature >= 95)); then
        printf 'CRITICAL'
    elif ((integer_temperature >= 85)); then
        printf 'WARNING'
    else
        printf 'NORMAL'
    fi
}

ping_state() {
    local address="$1"

    if [[ -z "${address}" ]]; then
        printf 'N/A'
    elif ping -n -c 1 -W 2 "${address}" >/dev/null 2>&1; then
        printf 'OK'
    else
        printf 'FAIL'
    fi
}

mkdir -p "$(dirname -- "${LOG_FILE}")"
touch "${LOG_FILE}"

boot_id="$(cat /proc/sys/kernel/random/boot_id)"
last_log_line="$(tail -n 1 "${LOG_FILE}" 2>/dev/null || true)"
last_boot_id="$(sed -n 's/.*BOOT_ID=\([^ ]*\).*/\1/p' <<<"${last_log_line}")"

if [[ -n "${last_log_line}" && "${last_log_line}" != *"EVENT=MONITOR_STOPPED"* ]]; then
    if [[ -n "${last_boot_id}" && "${last_boot_id}" != "${boot_id}" ]]; then
        log_line "EVENT=PREVIOUS_BOOT_ENDED_UNCLEANLY PREVIOUS_BOOT_ID=${last_boot_id} BOOT_ID=${boot_id}"
    else
        log_line "EVENT=MONITOR_PREVIOUSLY_STOPPED_UNCLEANLY BOOT_ID=${boot_id}"
    fi
fi

log_line "EVENT=MONITOR_STARTED BOOT_ID=${boot_id} INTERVAL=${INTERVAL_SECONDS}s"

stop_monitor() {
    log_line "EVENT=MONITOR_STOPPED BOOT_ID=${boot_id} REASON=SERVICE_STOP_OR_CLEAN_SHUTDOWN"
    sync -d "${LOG_FILE}" 2>/dev/null || true
    exit 0
}

trap stop_monitor TERM INT HUP

while true; do
    default_route="$(ip -4 route show default 2>/dev/null | head -n 1)"
    interface_name="$(awk '{for (i=1; i<=NF; i++) if ($i=="dev") print $(i+1)}' <<<"${default_route}")"
    gateway="$(awk '{for (i=1; i<=NF; i++) if ($i=="via") print $(i+1)}' <<<"${default_route}")"
    local_ip="$(ip -4 -o address show dev "${interface_name}" 2>/dev/null | awk 'NR==1 {split($4,a,"/"); print a[1]}')"

    if [[ -n "${interface_name}" && -r "/sys/class/net/${interface_name}/operstate" ]]; then
        read -r link_state <"/sys/class/net/${interface_name}/operstate"
    else
        link_state="NO_INTERFACE"
    fi

    ssh_service="$(systemctl is-active ssh.service 2>/dev/null || true)"
    if ss -H -ltn 'sport = :22' 2>/dev/null | grep -q .; then
        ssh_port="LISTEN"
    else
        ssh_port="CLOSED"
    fi

    established_ssh="$(
        ss -H -tn state established 'sport = :22' 2>/dev/null |
            wc -l |
            tr -d ' '
    )"
    gateway_ping="$(ping_state "${gateway}")"
    public_ping="$(ping_state "${PUBLIC_TEST_IP}")"
    cpu_temperature="$(read_cpu_temperature)"
    thermal_level="$(temperature_level "${cpu_temperature}")"
    igpu_temperature="$(read_igpu_temperature)"
    gpu_temperatures="$(read_gpu_temperatures)"
    cpu_frequency_mhz="$(read_cpu_frequency_mhz)"
    read -r uptime_seconds _ </proc/uptime
    load_average="$(cut -d ' ' -f 1-3 /proc/loadavg | tr ' ' ',')"
    memory_available_mb="$(awk '/MemAvailable:/ {printf "%d", $2 / 1024}' /proc/meminfo)"
    rx_errors="$(read_counter "/sys/class/net/${interface_name}/statistics/rx_errors")"
    rx_dropped="$(read_counter "/sys/class/net/${interface_name}/statistics/rx_dropped")"
    tx_errors="$(read_counter "/sys/class/net/${interface_name}/statistics/tx_errors")"
    tx_dropped="$(read_counter "/sys/class/net/${interface_name}/statistics/tx_dropped")"

    current_state="$(
        printf '%s|%s|%s|%s|%s|%s' \
            "${ssh_service}" "${ssh_port}" "${link_state}" \
            "${gateway_ping}" "${public_ping}" "${thermal_level}"
    )"

    if [[ -n "${previous_state}" && "${current_state}" != "${previous_state}" ]]; then
        log_line "EVENT=STATE_CHANGED FROM=${previous_state} TO=${current_state}"
    fi

    if [[ "${thermal_level}" != "${previous_thermal_level}" ]]; then
        log_line "EVENT=THERMAL_LEVEL_CHANGED LEVEL=${thermal_level} CPU_TEMP_C=${cpu_temperature} BOOT_ID=${boot_id}"
    fi

    log_line \
        "HEARTBEAT BOOT_ID=${boot_id} UPTIME_SEC=${uptime_seconds} LOAD=${load_average}" \
        "MEM_AVAILABLE_MB=${memory_available_mb} CPU_FREQ_AVG_MHZ=${cpu_frequency_mhz}" \
        "THERMAL_LEVEL=${thermal_level} CPU_TEMP_C=${cpu_temperature} IGPU_TEMP_C=${igpu_temperature}" \
        "NVIDIA_GPU_TEMP_C=${gpu_temperatures}" \
        "SSH_SERVICE=${ssh_service} SSH_PORT=${ssh_port} SSH_CONNECTIONS=${established_ssh}" \
        "IFACE=${interface_name:-NONE} LINK=${link_state} IP=${local_ip:-NONE}" \
        "GATEWAY=${gateway:-NONE} GATEWAY_PING=${gateway_ping} PUBLIC_PING=${public_ping}" \
        "RX_ERRORS=${rx_errors} RX_DROPPED=${rx_dropped}" \
        "TX_ERRORS=${tx_errors} TX_DROPPED=${tx_dropped}"

    # 尽量让最近的心跳在突然断电后仍保留在磁盘上。
    sync -d "${LOG_FILE}" 2>/dev/null || true

    previous_state="${current_state}"
    previous_thermal_level="${thermal_level}"
    sleep "${INTERVAL_SECONDS}"
done
